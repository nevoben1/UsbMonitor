<?xml version="1.0" encoding="utf-8"?>
<DeviceValidators>

  <!-- Logitech Wireless Mouse - Multiple validators with AND logic -->
  <!-- MULTI-VALUE EXAMPLE: Using multiple <ExpectedValue> elements -->
  <Device VidPid="VID_046D&PID_C52B">
    <PropertyValidator PropertyName="Manufacturer" Method="Contains">
      <ExpectedValue>Logitech</ExpectedValue>
      <ExpectedValue>Logitech Inc.</ExpectedValue>
      <ExpectedValue>Logitech, Inc.</ExpectedValue>
    </PropertyValidator>
    <PropertyValidator PropertyName="Status" ExpectedValue="OK" Method="Equals" />
    <PropertyValidator PropertyName="FriendlyName" ExpectedValue="Mouse" Method="Contains" />
  </Device>

  <!-- SanDisk USB Flash Drive - Single validator -->
  <Device VidPid="VID_0781&PID_5567">
    <PropertyValidator PropertyName="FriendlyName" ExpectedValue="USB" Method="Contains" />
  </Device>

  <!-- HP Printer - Using StartsWith validation -->
  <Device VidPid="VID_03F0&PID_0853">
    <PropertyValidator PropertyName="Manufacturer" ExpectedValue="HP" Method="StartsWith" />
    <PropertyValidator PropertyName="Status" ExpectedValue="OK" Method="Equals" />
    <PropertyValidator PropertyName="PNPClass" ExpectedValue="Printer" Method="Equals" />
  </Device>

  <!-- Generic USB Device - Using NotEquals to filter out unknowns -->
  <!-- MULTI-VALUE EXAMPLE: Exclude multiple manufacturer values -->
  <Device VidPid="VID_1234&PID_5678">
    <PropertyValidator PropertyName="Manufacturer" Method="NotEquals">
      <ExpectedValue>Unknown</ExpectedValue>
      <ExpectedValue>(Unknown)</ExpectedValue>
      <ExpectedValue>(Standard)</ExpectedValue>
    </PropertyValidator>
    <PropertyValidator PropertyName="Description" Method="NotContains">
      <ExpectedValue>Generic</ExpectedValue>
      <ExpectedValue>Standard</ExpectedValue>
      <ExpectedValue>Unknown</ExpectedValue>
    </PropertyValidator>
  </Device>

  <!-- Logitech Keyboard - Using regex pattern -->
  <Device VidPid="VID_046D&PID_C31C">
    <PropertyValidator PropertyName="FriendlyName" ExpectedValue="Logitech.*Keyboard" Method="Regex" />
    <PropertyValidator PropertyName="Status" ExpectedValue="OK" Method="Equals" />
  </Device>

  <!-- Microsoft Device - Using EndsWith -->
  <!-- MULTI-VALUE EXAMPLE: Accept multiple Status values -->
  <Device VidPid="VID_045E&PID_07F8">
    <PropertyValidator PropertyName="DeviceID" ExpectedValue="045E&amp;PID_07F8" Method="EndsWith" />
    <PropertyValidator PropertyName="Manufacturer" Method="Contains">
      <ExpectedValue>Microsoft</ExpectedValue>
      <ExpectedValue>Microsoft Corporation</ExpectedValue>
    </PropertyValidator>
    <PropertyValidator PropertyName="Status" Method="Equals">
      <ExpectedValue>OK</ExpectedValue>
      <ExpectedValue>Degraded</ExpectedValue>
    </PropertyValidator>
  </Device>

  <!-- Case-sensitive validation example -->
  <Device VidPid="VID_8087&PID_0A2B">
    <PropertyValidator PropertyName="Service" ExpectedValue="BTHUSB" Method="EqualsCaseSensitive" />
  </Device>

  <!-- Device with no validators (VID/PID only) -->
  <Device VidPid="VID_0BDA&PID_0129">
    <!-- No validators - will match on VID/PID only -->
  </Device>

</DeviceValidators>
